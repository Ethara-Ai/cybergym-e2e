# Copy to .env (gitignored) and adjust. Blank values fall back to defaults.
# Loaded before argument parsing; an explicit CLI flag still overrides.

# Rubric judge (codex only). Default: gpt-5.6-sol.
JUDGE_MODEL=gpt-5.6-sol

# Calibration call only; default = the rubric model. gpt-5.6-sol returns
# partial prediction arrays and gpt-5.5 no longer resolves, so pin a model
# that returns the full array: gpt-5.6-luna (cheapest) or gpt-5.6-terra.
JUDGE_CALIBRATION_MODEL=gpt-5.6-luna

# --- Claude account rotation (optional) --------------------------------------
# A single Claude subscription has a rolling 5-hour window and a rolling 7-day
# quota; once either is spent every request fails until it resets. Enrol several
# subscriptions here and the bridge fails over when the active one is capped.
# Leave blank for the normal single-account behaviour.
#
# Comma-separated entries, each one of:
#   /path/to/creds.json     a credentials file (the common case)
#   keychain:<service>      a macOS Keychain service name
#   default                 whichever account the `claude` CLI is logged into
#
# Order is the failover order: the first available entry is used, so put your
# primary account first.
#
# To add an account: `claude login`, then copy ~/.claude/.credentials.json to a
# per-account path. Repeat per subscription -- the CLI holds only one login at a
# time, so each `claude login` overwrites the previous one.
#   claude login && cp ~/.claude/.credentials.json ~/.claude/accounts/work.json
#   claude login && cp ~/.claude/.credentials.json ~/.claude/accounts/personal.json
#
# WCB_CC_ACCOUNT_POOL=~/.claude/accounts/work.json,~/.claude/accounts/personal.json
WCB_CC_ACCOUNT_POOL=

# Where cooldowns are shared between concurrent bridge processes (batch_run.sh
# starts one per task). Default: ~/.cache/wildclawbench/rotation-state.json
# Inspect:  python -m claude_oauth --pool-status      (run from scripts/)
# Reset:    python -m claude_oauth --clear-cooldowns
WCB_CC_ROTATION_STATE=
