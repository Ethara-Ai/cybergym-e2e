diff --git a/quickjs.c b/quickjs.c
index 6119975..9273fd0 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -53099,6 +53099,19 @@ static JSValue js_typed_array_indexOf(JSContext *ctx, JSValueConst this_val,
         goto done;
     }
 
+    /* The fromIndex argument coercion above may have executed a user
+       supplied valueOf() callback which detached or resized the
+       underlying (resizable) ArrayBuffer.  Re-clamp the scan bounds to
+       the current element count to avoid reading out of bounds. */
+    len = min_int(len, p->u.array.count);
+    if (len == 0)
+        goto done;
+    if (special == special_lastIndexOf)
+        k = min_int(k, len - 1);
+    else
+        k = min_int(k, len);
+    stop = min_int(stop, len);
+
     is_bigint = 0;
     is_int = 0; /* avoid warning */
     v64 = 0; /* avoid warning */
