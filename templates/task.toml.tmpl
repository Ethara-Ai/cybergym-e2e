schema_version = "1.1"
# "e2e" (find + PoC + patch) or "patch-only" (PoC given, patch only).
# The runner and the QC gate read this key; artifacts must agree with it.
mode = "%%MODE%%"
artifacts = %%ARTIFACTS%%

[task]
name = "%%TASK_NAME%%"
description = "%%DESCRIPTION%%"
keywords = ["security", "%%LANGUAGE%%", "memory-safety", "cybergym-e2e"]

[metadata]
difficulty = "hard"
category = "Security"
subcategory = "Vulnerability discovery"
family = "cybergym-e2e"
tags = ["cybergym", "%%MODE%%", "%%LANGUAGE%%", "fuzzing"]

[verifier]
timeout_sec = %%VERIFIER_TIMEOUT%%.0
environment_mode = "separate"

[agent]
timeout_sec = %%AGENT_TIMEOUT%%.0

[environment]
build_timeout_sec = 900.0
allow_internet = false
mcp_servers = []
